# Shared Node hosting (cPanel, Plesk) sets NODE_ENV=production, which makes
# `npm install` skip devDependencies — including typescript. This app is built
# from source on the host, so tsc must be installed there or the build fails
# with "tsc: command not found".
#
# `include=dev` forces them in regardless of NODE_ENV. The Dockerfile is
# unaffected: its dependency stage copies only package*.json, so this file is
# never present when it runs `npm ci --omit=dev`.
include=dev
