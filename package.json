{
  "name": "swagger-ui-woocommerce",
  "version": "1.0.0",
  "description": "OpenAPI 3.0.3 specification + Swagger UI for the WooCommerce REST API (v3), with a live try-it-out proxy. Companion demo to a WooCommerce MCP server.",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "spec:json": "tsx scripts/export-spec.ts json",
    "spec:yaml": "tsx scripts/export-spec.ts yaml",
    "spec:validate": "tsx scripts/validate-spec.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "node scripts/clean.mjs"
  },
  "keywords": [
    "woocommerce",
    "openapi",
    "swagger",
    "swagger-ui",
    "rest-api",
    "mcp",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/swagger-ui-express": "^4.1.7",
    "openapi-types": "^12.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
