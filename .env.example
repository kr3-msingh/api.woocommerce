# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public URL this app is reachable at (used for the OpenAPI `servers` block and
# absolute links on the landing page). No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# WooCommerce store (target of the live "Try it out" proxy)
# ---------------------------------------------------------------------------
# Root URL of the WordPress site, no trailing slash, no /wp-json.
WOO_STORE_URL=https://your-store.example.com

# REST API keys: WooCommerce > Settings > Advanced > REST API > Add key
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WooCommerce REST namespace version: wc/v3 (default), wc/v2, wc/v1
WOO_API_VERSION=wc/v3

# Send credentials as ?consumer_key=&consumer_secret= instead of HTTP Basic.
# Needed for plain-HTTP stores or hosts that strip the Authorization header.
WOO_USE_QUERY_STRING_AUTH=false

# Upstream request timeout, milliseconds
WOO_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Proxy safety
# ---------------------------------------------------------------------------
# Enable the /api/wc proxy at all. Set false to ship docs only.
PROXY_ENABLED=true

# Read-only guard. When false, POST/PUT/PATCH/DELETE through the proxy are
# rejected with 405 so a public demo cannot mutate a real store.
PROXY_ALLOW_WRITES=false

# Requests per window per IP against the proxy
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Comma-separated allowed CORS origins, or * for any
CORS_ORIGIN=*
